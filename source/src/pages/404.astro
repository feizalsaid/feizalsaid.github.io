---
import BaseLayout from '../components/BaseLayout.astro';
---

<BaseLayout
  title="404 — Not Found"
  description="Page not found."
  noindex
>
  <section class="nf">
    <p class="nf-prefix font-mono accent">$ ls -la 404</p>
    <h1 class="nf-title font-display">404 — not found</h1>
    <p class="nf-desc">
      That route doesn't exist. Check the URL, or head back home.
    </p>
    <a class="btn font-mono" href="/">cd ~/ → Home</a>
  </section>
</BaseLayout>

<style is:global>
  .nf {
    max-width: 48rem;
    margin: 0 auto;
    padding: 6rem 1.25rem;
    text-align: center;
  }
  .nf-prefix { color: var(--accent-text); margin-bottom: 1rem; font-size: 0.9rem; }
  .nf-title { font-size: 2.2rem; margin: 0 0 1rem; }
  .nf-desc { color: var(--text-secondary); margin-bottom: 2rem; }
  .btn {
    display: inline-block;
    padding: 0.6rem 1.2rem;
    border-radius: var(--radius-sm);
    background: var(--accent);
    color: #000;
    text-decoration: none;
  }
  .btn:hover { filter: brightness(1.1); text-decoration: none; }
  .accent { color: var(--accent-text); }
</style>
