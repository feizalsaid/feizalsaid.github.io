---
import BaseLayout from '../components/BaseLayout.astro';
import PageHeader from '../components/PageHeader.astro';
import { PROJECTS } from '../data/site';
---

<BaseLayout
  title="Projects"
  description="Security projects: Wazuh SIEM stack, Splunk lateral movement detection, Vagrant lab automation, offensive security writeups, and this portfolio site."
  canonical="/projects/"
  ogImage="/images/og-cover.png"
>
  <PageHeader
    title="Projects"
    prefix="~/projects"
    description="Longer-running builds and the lab work behind them — each with its own writeup."
  />

  <div class="wrap">
    <ol class="project-list">
      {PROJECTS.map((p, i) => (
        <li class="card project-card">
          <a class="project-link" href={p.href} target={p.external ? '_blank' : undefined} rel={p.external ? 'noopener noreferrer' : undefined}>
            <div class="project-index font-mono accent" aria-hidden="true">{String(i + 1).padStart(2, '0')}</div>
            <div class="project-body">
              <h2 class="project-name font-display">{p.name}</h2>
              <p class="project-desc">{p.description}</p>
              <ul class="project-tags">
                {p.tags.map((t) => <li class="tag">{t}</li>)}
              </ul>
              <span class="project-cta font-mono">{p.external ? 'view on github ↗' : 'read writeup →'}</span>
            </div>
          </a>
        </li>
      ))}
    </ol>
  </div>
</BaseLayout>

<style is:global>
  .wrap {
    max-width: 60rem;
    margin: 0 auto;
    padding: 0.5rem 1.25rem 4rem;
  }
  .project-list {
    list-style: none;
    padding: 0;
    margin: 0;
    display: flex;
    flex-direction: column;
    gap: 1.25rem;
  }
  .project-card { transition: transform 0.2s ease, box-shadow 0.2s ease, border-color 0.2s ease; }
  .project-card:hover {
    transform: translateY(-2px);
    border-color: var(--border-hover);
    box-shadow: var(--shadow-lg);
  }
  .project-link {
    display: flex;
    gap: 1.25rem;
    padding: 1.5rem;
    color: inherit;
    text-decoration: none;
  }
  .project-index {
    font-size: 1.4rem;
    font-weight: 600;
    min-width: 2.4rem;
    color: var(--accent-text);
  }
  .project-name { font-size: 1.2rem; margin: 0 0 0.5rem; color: var(--text); }
  .project-desc { color: var(--text-secondary); line-height: 1.65; margin: 0 0 0.9rem; }
  .project-tags {
    list-style: none;
    padding: 0;
    margin: 0 0 1rem;
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
  }
  .project-cta {
    color: var(--accent-text);
    font-size: 0.82rem;
  }
  .accent { color: var(--accent-text); }
  @media (max-width: 560px) {
    .project-link { flex-direction: column; gap: 0.5rem; }
  }
</style>
